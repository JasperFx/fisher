<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
            <!-- fisher#337 / jasperfx#892: conventional Apply/Create methods have no runtime fallback, so a
             generator that stopped reaching this project would compile clean and fail at the first
             fold. This makes that a build error (JFXEVT900) instead of an assumption. -->
        <JasperFxEventsRequireSourceGenerator>true</JasperFxEventsRequireSourceGenerator>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
        <Using Include="Fisher.TestUtils" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\Fisher.AspNetCore\Fisher.AspNetCore.csproj" />
        <ProjectReference Include="..\Fisher.TestUtils\Fisher.TestUtils.csproj" />
        <PackageReference Include="JasperFx.Events.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
