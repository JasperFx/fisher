<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
            <!-- fisher#337 / jasperfx#892: conventional Apply/Create methods have no runtime fallback, so a
             generator that stopped reaching this project would compile clean and fail at the first
             fold. This makes that a build error (JFXEVT900) instead of an assumption. -->
        <JasperFxEventsRequireSourceGenerator>true</JasperFxEventsRequireSourceGenerator>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
        <Using Include="Fisher.TestUtils" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fisher.EntityFrameworkCore\Fisher.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\Fisher.TestUtils\Fisher.TestUtils.csproj" />
        <!-- The conventional Apply/Create/ShouldDelete dispatcher is source-generated and has no
             runtime fallback, and the generator runs in the assembly that DEFINES the aggregate — so
             an EF entity projected into here needs it as much as an aggregate in Fisher.Tests does. -->
        <PackageReference Include="JasperFx.Events.SourceGenerator" OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
