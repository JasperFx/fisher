<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="packed" value="../../artifacts/smoke" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!-- Fisher comes ONLY from the package just packed, never from nuget.org — otherwise a smoke run
         could quietly pass against the last published release instead of this commit. -->
    <packageSourceMapping>
        <packageSource key="packed">
            <package pattern="Fisher" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
