<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- An xunit v3 test project is its own MTP executable and will not build without this.
             Microsoft.NET.Test.Sdk used to set it and is no longer referenced. -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
        <Using Include="Fisher.TestUtils" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fisher.TestUtils\Fisher.TestUtils.csproj" />
        <ProjectReference Include="..\Fisher\Fisher.csproj" />
        <PackageReference Include="JasperFx.Events.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- Source-only: every suite compiles into this assembly, so the aggregate source generator
             above binds Fisher's session types. See Compliance/ for the enrollments.

             All suites COMPILE; only the ones subclassed in fisher_event_store_compliance.cs RUN.
             That is why the global aliases in Compliance/ComplianceAliases.cs must all resolve even
             for suites Fisher cannot pass yet — a shared source file referencing
             ComplianceEventProjection is compiled whether or not it is enrolled. -->
        <PackageReference Include="JasperFx.Events.ComplianceTests" />

        <!-- The two EventProjection suites are the only shared sources that do not merely *use* the
             store's session types but call document APIs on them — IDocumentSession.Store and
             IQuerySession.LoadAsync. Fisher has neither, so these two files cannot compile at all
             and have to be removed rather than just left un-enrolled like every other suite Fisher
             is not ready for. Delete these two lines once document storage lands; the
             ComplianceEventProjection alias they bind to already exists. -->
        <Compile Remove="$(NuGetPackageRoot)jasperfx.events.compliancetests\**\EventProjectionRegistrationCompliance.cs" />
        <Compile Remove="$(NuGetPackageRoot)jasperfx.events.compliancetests\**\EventProjectionEnrichmentCompliance.cs" />
    </ItemGroup>

</Project>
